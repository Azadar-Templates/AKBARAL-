# AKBARAL! / MASTER AI — environment template (SAFE PLACEHOLDERS ONLY).
# Copy to `.env` and fill in real values locally. NEVER commit `.env`.
#
# Server behavior:
#   - development/test: if SESSION_SECRET is absent a cryptographically strong
#     random secret is generated for the process lifetime.
#   - production: SESSION_SECRET MUST be explicitly set to a random string of
#     at least 32 characters or the server refuses to start.
#
# DEPLOYMENT-SCANNER CONVENTION (read before editing):
#   Only CORE variables are left UNCOMMENTED below. Deployment platforms
#   (SnapDeploy etc.) scan this file and present every uncommented `VAR=`
#   entry as a required input. Optional integrations are deliberately
#   COMMENTED OUT so no UI ever demands credentials the core product does
#   not need — each one fails honestly (reported as not configured, with
#   the required env var name) only when its specific capability is used.
#   The application itself enforces exactly two required values in
#   production: DATABASE_URL and SESSION_SECRET (plus GOOGLE_API_KEY for
#   the MASTER→Gemini path); this is locked by src/config/env.test.ts.

# --- Core (uncommented: prefilled safe defaults; SESSION_SECRET is the
#     only value that genuinely requires input) ------------------------------
HOST="0.0.0.0"
PORT=3000
# SQLite (local development/tests): file:./data/akbaral.db or :memory:
# PostgreSQL (production / Neon):   postgres://user:password@host/db?sslmode=require
DATABASE_URL="file:./data/akbaral.db"
# Production: random, >=32 chars (e.g. `openssl rand -base64 48`). Never share.
SESSION_SECRET=""
# Operator-facing base URL used in password-reset / email-verification links.
AKBARAL_PUBLIC_WEB_URL="http://localhost:3000"
# Persistent upload directory. In Docker this is mounted at /data/uploads.
AKBARAL_UPLOAD_DIR="data/uploads"
# Set to 1 when running behind exactly one trusted TLS reverse proxy so rate
# limiting and request logging use the real client IP. Keep 0 when exposed
# directly to the internet.
TRUST_PROXY="0"

# --- Core, platform-provided (do not set manually) ---------------------------
# NODE_ENV: the production Docker image forces NODE_ENV=production on every
# tier (scripts/start-prod.mjs). Unset = development locally.
# NODE_ENV="development"

# --- Research / web fetch (OPTIONAL: DuckDuckGo direct is the default) -------
# AKBARAL_SEARCH_ENDPOINT=""
# AKBARAL_PAGE_FETCH_ENDPOINT=""
# Only "1" when routing through a trusted internal search/fetch provider.
# This relaxes validation for that provider host only; arbitrary private source
# URLs are still rejected by SSRF protection. Never set in production.
# AKBARAL_ALLOW_PRIVATE_PROVIDER="0"

# --- Browser origins (OPTIONAL: the SPA is same-origin) ----------------------
# CORS_ORIGINS=""

# --- Session rotation (OPTIONAL) ----------------------------------------------
# After changing SESSION_SECRET, set the OLD value here so already-issued
# access tokens stay valid for their remaining lifetime (1 hour).
# SESSION_SECRET_PREVIOUS=""

# --- Model providers (OPTIONAL; each feature fails honestly when unset) ------
# GOOGLE_API_KEY=""      <- required only for the MASTER→Gemini path
# OPENAI_API_KEY=""
# ANTHROPIC_API_KEY=""
# Base URL overrides for enterprise proxies, Azure-style gateways or
# self-hosted OpenAI-compatible endpoints (must not end with a slash).
# Preview/fixture plumbing only — NEVER set in production.
# OPENAI_BASE_URL=""
# ANTHROPIC_BASE_URL=""
# GOOGLE_BASE_URL=""

# --- Execution queue (OPTIONAL: safe in-code defaults) ------------------------
# AKBARAL_QUEUE_CONCURRENCY=1
# AKBARAL_EXECUTION_MAX_ATTEMPTS=2
# AKBARAL_EXECUTION_RETRY_BASE_DELAY_MS=2000
# AKBARAL_EXECUTION_STEP_TIMEOUT_MS=120000
# AKBARAL_WORKFLOW_TIMEOUT_MS=900000

# --- Account protection (Milestone 9) ------------------------------------------
# Per-account login brute-force lockout: after 10 failed logins for the same
# account within 15 minutes, further attempts are rejected with 429 until
# the window passes (the block is logged at critical severity in security_logs).
# Threshold/window are compile-time constants in src/auth/service.ts.

# --- Billing (OPTIONAL: credits/refunds are internal) ---------------------------
# Shared secret for signing/verifying billing webhooks (required for the
# /api/billing/webhook endpoint to accept any payload).
# BILLING_WEBHOOK_SECRET=""
# Marketplace commission on agent-order volume, in basis points (1000 = 10%).
# AKBARAL_MARKETPLACE_COMMISSION_BPS=1000

# --- Payment provider (OPTIONAL) ------------------------------------------------
# When unset, custom credit purchase returns provider_not_configured + the
# required variable name; manual admin settlement remains available.
# STRIPE_SECRET_KEY=""
# RAZORPAY_KEY_ID=""
# RAZORPAY_KEY_SECRET=""

# --- Email / SMTP (OPTIONAL) ------------------------------------------------------
# Required only for password reset, email verification and campaign delivery.
# In development/test without SMTP the flow returns a devToken; in production
# without SMTP those endpoints answer 503 provider_not_configured (honest).
# SMTP_HOST=""
# SMTP_USER=""
# SMTP_PASSWORD=""
# SMTP_FROM="Akbaral <no-reply@akbaral.ai>"
# SMTP_PORT="587"
# SMTP_SECURE="0"
# SMTP_EHLO="akbaral.local"
# SMTP_TIMEOUT_MS="10000"

# --- OAuth providers (OPTIONAL) -----------------------------------------------------
# Provider credentials are only used by the matching OAuth flow. When unset the
# provider is reported as not configured and email/password auth remains active.
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# GITHUB_CLIENT_ID=""
# GITHUB_CLIENT_SECRET=""
# APPLE_CLIENT_ID=""
# APPLE_CLIENT_SECRET=""
# MS_CLIENT_ID=""
# MS_CLIENT_SECRET=""

# --- Advertising (OPTIONAL; launch readiness / AdSense) -----------------------------
# Real Google AdSense publisher id (e.g. ca-pub-1234567890123456). When unset
# (the launch default) the web app loads NO ad script, renders NO ad slots,
# shows NO consent banner and serves NO ads.txt — advertising stays honestly
# disabled. When set, ads load only after the visitor accepts the
# advertising-consent banner, in clearly labelled slots below main content.
# AKBARAL_ADSENSE_CLIENT=""

# --- Social / marketing integrations (OPTIONAL) ---------------------------------------
# These are real integrations; the platform surfaces them as credentials
# required by the relevant specialist agents/tools — requested lazily, only
# when that agent's capability is actually used. Never fabricate values.
# YOUTUBE_ACCESS_TOKEN=""
# INSTAGRAM_ACCESS_TOKEN=""
# X_BEARER_TOKEN=""
# SHOPIFY_STORE_DOMAIN=""
# SHOPIFY_ACCESS_TOKEN=""
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
