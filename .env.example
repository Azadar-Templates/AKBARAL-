# AKBARAL! / MASTER AI — environment template.
# Copy to .env and fill in real values. Never commit secrets.

# --- Core ------------------------------------------------------------------
NODE_ENV="development"
HOST="0.0.0.0"
PORT=3000
DATABASE_URL="file:./data/akbaral.db"
SESSION_SECRET="replace-with-a-long-random-secret"
# Persistent upload directory. In Docker this is mounted at /data/uploads.
AKBARAL_UPLOAD_DIR="data/uploads"

# --- Research / web fetch (Agent #001 and web_search/page_fetch tools) ------
# DuckDuckGo HTML is the default; route through a compliant proxy or private
# JSON search API when the deployment blocks direct outbound web access.
# AKBARAL_SEARCH_ENDPOINT="https://html.duckduckgo.com/html/"
# AKBARAL_PAGE_FETCH_ENDPOINT="https://your-fetch-proxy.example.com/fetch"
# Only set this when routing through a trusted internal search/fetch provider.
# AKBARAL_ALLOW_PRIVATE_PROVIDER="0"

# --- Model providers --------------------------------------------------------
# The model router only enables a provider when its credential is set and it
# will honestly return provider_not_configured otherwise.
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GOOGLE_API_KEY=""

# --- Payment provider (optional) --------------------------------------------
# Used by billing custom credit purchase. When unset the order is returned as
# provider_not_configured and the UI explains the required env var.
# STRIPE_SECRET_KEY=""
# RAZORPAY_KEY_ID=""
# RAZORPAY_KEY_SECRET=""

# --- Authentication / account recovery ---------------------------------------
# Password reset and email verification require an SMTP transport in production.
# In development/test the flow returns a devToken so it can be exercised.
SMTP_HOST=""
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Akbaral <no-reply@akbaral.ai>"

# --- OAuth providers (optional) -----------------------------------------------
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# GITHUB_CLIENT_ID=""
# GITHUB_CLIENT_SECRET=""
# APPLE_CLIENT_ID=""
# APPLE_CLIENT_SECRET=""
# MS_CLIENT_ID=""
# MS_CLIENT_SECRET=""

# --- Webhooks ------------------------- ----------------------------------------
# Signed billing webhooks use X-AKBARAL-Signature: sha256=<hmac>.
# BILLING_WEBHOOK_SECRET=""

# --- Social / marketing integrations (optional) ------------------------------
# These are real integrations; the platform surfaces them as credentials
# required by the relevant specialist agents/tools.
# YOUTUBE_API_KEY=""
# TIKTOK_ACCESS_TOKEN=""
# INSTAGRAM_ACCESS_TOKEN=""
# X_BEARER_TOKEN=""
# SHOPIFY_ACCESS_TOKEN=""
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
