# Copy to .env and adjust for your environment.
# Never commit real credentials.

# SQLite database file path, relative to the repository root.
DATABASE_URL="file:./data/akbaral.db"

# Runtime environment (development | test | production)
NODE_ENV="development"

# Short-lived session secret used for authentication signing.
# Replace with a long random value in production.
SESSION_SECRET="change-me-in-production"

# Server bind host and port.
HOST="0.0.0.0"
PORT=3000

# Optional research provider overrides.
# When unset, Agent #001 uses DuckDuckGo HTML search and fetches source URLs
# directly. In environments where direct outbound web access is restricted,
# point these at a compliant search/fetch proxy or private API.
# AKBARAL_SEARCH_ENDPOINT="https://html.duckduckgo.com/html/"
# AKBARAL_PAGE_FETCH_ENDPOINT=""
