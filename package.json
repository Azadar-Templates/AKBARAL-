{
  "name": "akbaral-master-ai",
  "version": "0.1.0",
  "private": true,
  "description": "AKBARAL! / MASTER AI \u2014 Master AI operating platform (User Goal -> AI Core -> Specialist Agents -> Tools/APIs -> Execution -> Verification -> Final Result).",
  "type": "commonjs",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "node scripts/start-dev.mjs",
    "start": "node scripts/start-prod.mjs",
    "serve": "tsx src/index.ts",
    "next:dev": "next dev -p 3000",
    "next:start": "next start -p 3000",
    "build": "tsc -p tsconfig.backend.json && node scripts/copy-backend-runtime-assets.mjs && next build",
    "build:webpack": "tsc -p tsconfig.backend.json && node scripts/copy-backend-runtime-assets.mjs && next build --webpack",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node scripts/test-resumable.mjs --all",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:migrate:dev": "tsx src/db/migrate.ts",
    "db:backup": "tsx src/scripts/backup-db.ts",
    "db:restore": "tsx src/scripts/restore-db.ts",
    "db:status": "tsx src/db/migrate.ts --status",
    "db:seed": "tsx src/db/seed.ts",
    "db:reset": "tsx src/db/reset.ts",
    "db:push": "tsx src/db/migrate.ts",
    "verify:db": "npm run db:migrate && tsx src/db/verify.ts",
    "audit:registry": "tsx scripts/audit-registry.ts",
    "scan:secrets": "tsx scripts/scan-secrets.ts",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test:pg": "node scripts/pg-test-server.mjs --run sh -c \"npx tsx src/db/migrate.ts && npx tsx src/db/seed.ts && npx tsx --test --test-force-exit src/db/postgres.integration.test.ts && npx tsx --test --test-force-exit src/db/workforce-parity.test.ts && npx tsx --test --test-force-exit src/economy/financial-atomicity.test.ts\"",
    "mission:init": "tsx scripts/mission-init.ts",
    "mission:serve": "tsx scripts/mission-serve.ts",
    "mission:sync-registry": "tsx scripts/mission-sync-registry.ts",
    "launch:check": "tsx scripts/launch-check.ts",
    "mission:pg-check": "cross-env PG_TEST_DATA_DIR=.pglite-mission-test node scripts/pg-test-server.mjs --run sh -c 'ZA141251SA_DATABASE_URL=$PG_TEST_DATABASE_URL npx tsx scripts/mission-pg-check.ts && npx tsx --test --test-force-exit src/mission/mission-financial-atomicity.test.ts'",
    "smoke:task3": "node scripts/live-smoke-task3.mjs",
    "smoke:shell": "node scripts/live-shell-smoke.mjs",
    "smoke:artifacts": "node scripts/live-artifact-smoke.mjs",
    "audit:responsive": "node scripts/responsive-audit.mjs",
    "audit:responsive:selftest": "node scripts/responsive-audit.mjs --selftest --widths=320",
    "audit:routes": "node scripts/rendered-route-audit.mjs",
    "fixture:model": "tsx scripts/local-model-fixture.ts",
    "verify:user-journey": "node scripts/verify-user-journey.mjs",
    "verify:refresh": "node scripts/verify-refresh-deeplinks.mjs",
    "verify:mission-lock": "node scripts/verify-mission-identity-lock.mjs",
    "verify:owner-identity": "node scripts/verify-owner-identity.mjs",
    "verify:mission-money": "node scripts/verify-mission-money.mjs",
    "verify:agent-fleet": "node scripts/verify-agent-fleet.mjs",
    "verify:recovery": "node scripts/verify-recovery.mjs",
    "verify:owner-entitlement": "node scripts/verify-owner-entitlement.mjs",
    "test:batch": "node scripts/test-resumable.mjs",
    "test:status": "node scripts/test-resumable.mjs --status"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "framer-motion": "^12.43.0",
    "multer": "^2.3.0",
    "next": "^16.3.4",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.13",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/ws": "^8.5.12",
    "cross-env": "^7.0.3",
    "jsdom": "^30.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "overrides": {
    "qs": "6.16.0"
  }
}
