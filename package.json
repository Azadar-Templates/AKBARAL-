{
  "name": "akbaral-master-ai",
  "version": "0.1.0",
  "private": true,
  "description": "AKBARAL! / MASTER AI — Master AI operating platform (User Goal -> AI Core -> Specialist Agents -> Tools/APIs -> Execution -> Verification -> Final Result).",
  "type": "commonjs",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "node scripts/start-dev.mjs",
    "start": "node scripts/start-prod.mjs",
    "serve": "tsx src/index.ts",
    "next:dev": "next dev -p 3000",
    "next:start": "next start -p 3000",
    "build": "tsc -p tsconfig.backend.json && next build --webpack",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "rm -f test.db && cross-env DATABASE_URL=file:./test.db npm run db:migrate && for f in $(find src -name \"*.test.ts\" | sort); do cross-env DATABASE_URL=file:./test.db tsx --test --test-concurrency=1 --test-force-exit \"$f\" || exit 1; done",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:migrate:dev": "tsx src/db/migrate.ts",
    "db:status": "tsx src/db/migrate.ts --status",
    "db:seed": "tsx src/db/seed.ts",
    "db:reset": "tsx src/db/reset.ts",
    "db:push": "tsx src/db/migrate.ts",
    "verify:db": "npm run db:migrate && tsx src/db/verify.ts",
    "audit:registry": "tsx scripts/audit-registry.ts",
    "scan:secrets": "tsx scripts/scan-secrets.ts",
    "lint": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "framer-motion": "^12.43.0",
    "multer": "^2.3.0",
    "next": "^16.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.13",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/ws": "^8.5.12",
    "cross-env": "^7.0.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "overrides": {
    "qs": "6.16.0"
  }
}
