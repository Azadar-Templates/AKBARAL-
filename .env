# Local development database connection.
# This file intentionally contains NO secrets. For production, use a managed
# database and keep real secrets outside version control.
#
# With the built-in SQLite connector, the path is relative to the repository root.
DATABASE_URL="file:./data/akbaral.db"

# Runtime environment (development | test | production)
NODE_ENV="development"

# Short-lived local session secret placeholder. Replace in production.
SESSION_SECRET="change-me-in-production"
