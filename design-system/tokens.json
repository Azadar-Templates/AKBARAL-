{
  "name": "AKBARAL! Design System",
  "version": "6.0.0",
  "tagline": "AKBARAL! — One Intelligence. Every Solution.",
  "description": "The single source of truth for AKBARAL! across web, Android and iOS. An obsidian foundation, confident AKBARAL! green signal, cinematic glass, disciplined typography and accessible motion.",
  "principles": [
    "Midnight first — content sits on neutral 900 and 950, never flat black.",
    "One brand signal: AKBARAL! green (#2f8348). It marks intelligence, focus and action.",
    "Green atmosphere stays restrained — light reveals structure instead of becoming decoration.",
    "Hairlines, generous whitespace and editorial type create precision.",
    "Glass communicates depth only where hierarchy benefits from it.",
    "Motion is cinematic, purposeful and always has a reduced-motion equivalent.",
    "Every product diagram describes real platform behavior.",
    "One identity, native feel: shared tokens with platform-appropriate interaction."
  ],
  "color": {
    "dark": {
      "bgDeep": "#020617",
      "bg": "#0f172a",
      "bg2": "#111c32",
      "bg3": "#17233a",
      "surfaceRgba": "rgba(248,250,252,0.055)",
      "surface2Rgba": "rgba(248,250,252,0.085)",
      "surfaceSolid": "#111c32",
      "surface2Solid": "#17233a",
      "surfaceStrong": "#1e293b",
      "glassFill": "rgba(2,6,23,0.66)",
      "line": "rgba(226,232,240,0.10)",
      "lineStrong": "rgba(226,232,240,0.18)",
      "lineFaint": "rgba(226,232,240,0.055)",
      "lineAccent": "rgba(47,131,72,0.44)",
      "text": "#f8fafc",
      "text2": "#cbd5e1",
      "textDim": "#94a3b8",
      "textFaint": "#94a3b8",
      "accent": "#2f8348",
      "accent2": "#286f3d",
      "accentSoft": "rgba(47,131,72,0.14)",
      "indigoSoft": "rgba(47,131,72,0.16)",
      "onAccent": "#ffffff",
      "onIvory": "#020617",
      "ivory": "#f8fafc",
      "telemetry": "#7dd3fc",
      "telemetrySoft": "rgba(125,211,252,0.12)",
      "green": "#22c55e",
      "greenSoft": "rgba(34,197,94,0.12)",
      "red": "#ef4444",
      "redSoft": "rgba(239,68,68,0.12)",
      "amber": "#f59e0b",
      "amberSoft": "rgba(245,158,11,0.12)",
      "blue": "#3b82f6",
      "blueSoft": "rgba(59,130,246,0.12)",
      "accentBright": "#69ad7d"
    }
  },
  "typography": {
    "families": {
      "web": {
        "sans": "\"Inter\", system-ui, -apple-system, sans-serif",
        "display": "\"Inter\", system-ui, -apple-system, sans-serif",
        "mono": "\"JetBrains Mono\", \"Fira Code\", monospace"
      },
      "mobile": "Native system font (SF Pro on iOS, Roboto on Android) — same scale, weight and tracking semantics as web."
    },
    "scale": {
      "micro": {
        "size": 11,
        "weight": 700,
        "tracking": 2,
        "case": "upper",
        "webSize": 11.5,
        "phoneSize": 12
      },
      "xs": {
        "size": 13,
        "weight": 400,
        "tracking": 0
      },
      "body": {
        "size": 15,
        "weight": 400,
        "tracking": 0
      },
      "emphasis": {
        "size": 15,
        "weight": 700,
        "tracking": 0
      },
      "md": {
        "size": 17,
        "weight": 600,
        "tracking": 0
      },
      "heading": {
        "size": 19,
        "weight": 800,
        "tracking": -0.3
      },
      "xl": {
        "size": 24,
        "weight": 800,
        "tracking": -0.4
      },
      "xxl": {
        "size": 30,
        "weight": 900,
        "tracking": -0.5
      },
      "display": {
        "size": 34,
        "weight": 900,
        "tracking": -0.5
      },
      "displayXl": {
        "size": "clamp(3.2rem, 9.5vw, 8.5rem)",
        "weight": 600,
        "tracking": -0.035
      },
      "chapterTitle": {
        "size": "clamp(2.1rem, 4.4vw, 3.8rem)",
        "weight": 600,
        "tracking": -0.024
      }
    },
    "notes": "Web keeps its fluid clamp() display sizes (see styles.css); the token scale is the shared hierarchy reference. Eyebrows/kickers are always micro: uppercase, tracking +2, mono on web."
  },
  "spacing": {
    "xs": 4,
    "sm": 8,
    "md": 12,
    "lg": 16,
    "xl": 22,
    "xxl": 30,
    "xxxl": 44
  },
  "radius": {
    "sm": 4,
    "md": 8,
    "lg": 12,
    "xl": 18,
    "pill": 999
  },
  "border": {
    "hairline": 1,
    "note": "All structural borders are 1px hairlines in the line ramp. Accent borders use lineAccent. Never 2px+ structural borders."
  },
  "surface": {
    "glass": {
      "fillDark": "rgba(9,11,24,0.62)",
      "fillLight": "rgba(248,249,253,0.72)",
      "blurPx": 18,
      "saturate": 1.25,
      "usage": "Sticky header, auth card, modals/scrims, toasts, dropdown sheets. Mobile approximates glass with surfaceSolid + hairline + top sheen (no blur)."
    },
    "card": {
      "fill": "surfaceSolid over bg2",
      "topSheen": "1px inner top highlight, rgba(255,255,255,0.05)",
      "note": "Cards sit on bg2 with a hairline border; premium feel comes from the sheen + shadow, not heavy fills."
    }
  },
  "shadow": {
    "dark": {
      "shadow": "0 30px 80px rgba(0,0,0,0.5)",
      "shadowSoft": "0 12px 36px rgba(0,0,0,0.32)",
      "glowAccent": "0 0 0 1px rgba(47,131,72,0.32), 0 10px 32px rgba(32,91,50,0.22)",
      "glowTelemetry": "0 0 0 1px rgba(105,173,125,0.24), 0 10px 28px rgba(47,131,72,0.14)"
    },
    "light": {
      "shadow": "0 30px 80px rgba(24,24,32,0.14)",
      "shadowSoft": "0 12px 36px rgba(24,24,32,0.09)",
      "glowAccent": "0 0 0 1px rgba(103,96,214,0.22), 0 10px 30px rgba(103,96,214,0.1)",
      "glowTelemetry": "0 0 0 1px rgba(46,125,158,0.18), 0 10px 28px rgba(46,125,158,0.08)"
    },
    "mobile": {
      "card": {
        "color": "#000000",
        "opacity": 0.42,
        "radius": 16,
        "offsetY": 8,
        "elevation": 5
      },
      "glow": {
        "color": "#2f8348",
        "opacity": 0.22,
        "radius": 18,
        "offsetY": 0,
        "elevation": 6
      }
    }
  },
  "gradient": {
    "accent": "linear-gradient(135deg, #69ad7d 0%, #2f8348 52%, #205b32 100%)",
    "buttonPrimary": "linear-gradient(180deg, #69ad7d 0%, #2f8348 52%, #286f3d 100%)",
    "buttonPrimaryLight": "linear-gradient(180deg, #94c5a1 0%, #2f8348 60%, #286f3d 100%)",
    "atmosphereHero": "radial-gradient(120% 90% at 18% 8%, rgba(47,131,72,0.22) 0%, rgba(32,91,50,0.08) 38%, transparent 72%)",
    "atmospherePanel": "radial-gradient(90% 70% at 80% 0%, rgba(47,131,72,0.13) 0%, transparent 70%)",
    "sheen": "linear-gradient(180deg, rgba(255,255,255,0.07), rgba(255,255,255,0))"
  },
  "motion": {
    "duration": {
      "instant": 120,
      "fast": 200,
      "base": 320,
      "slow": 560,
      "cinematic": 900
    },
    "easing": {
      "out": "cubic-bezier(0.22,0.61,0.36,1)",
      "soft": "cubic-bezier(0.33,1,0.68,1)"
    },
    "staggerMs": 80,
    "reducedMotion": "prefers-reduced-motion (web) / AccessibilityInfo.isReduceMotionEnabled (mobile): disable parallax, marquees, magnetic pull, particle drift and pulses; keep instant opacity-only state changes. All entrance reveals settle to visible."
  },
  "status": {
    "mapping": {
      "live": "telemetry",
      "running": "telemetry",
      "streaming": "telemetry",
      "queued": "amber",
      "pending": "amber",
      "planned": "amber",
      "scheduled": "amber",
      "retrying": "amber",
      "needs_review": "amber",
      "completed": "green",
      "succeeded": "green",
      "active": "green",
      "enabled": "green",
      "published": "green",
      "failed": "red",
      "blocked": "red",
      "disabled": "red",
      "error": "red",
      "cancelled": "neutral",
      "paused": "neutral",
      "idle": "neutral",
      "unknown": "neutral"
    },
    "note": "Status dots: 8-10px circle with a soft glow in the status color; running/live states pulse. Same mapping and behavior on web and mobile."
  },
  "agent": {
    "sigil": {
      "formula": "hue = 222 + (fnv1a(name + '|' + category) % 78) — a deterministic indigo→violet band (222..299)",
      "monogram": "Initials of the first two words of the agent name (single word: first two characters), uppercase.",
      "container": "Rounded-square (radius lg), 1px border hsla(hue,90%,74%,0.42), fill hsla(hue,90%,64%,0.15), monogram text hsla(hue,95%,82%,1), weight 800.",
      "sizes": {
        "sm": 30,
        "md": 38,
        "lg": 46
      },
      "note": "The sigil is THE agent identity mark — identical formula on web, Android and iOS. It gives 4,001 agents a calm, consistent visual language without 4,001 colors."
    }
  },
  "iconography": {
    "glyphs": {
      "dashboard": "▣",
      "master": "◉",
      "tasks": "◍",
      "agents": "⬡",
      "workspace": "▤",
      "automation": "◆",
      "billing": "◈",
      "settings": "⚙",
      "security": "⬢",
      "live": "●",
      "arrow": "→",
      "theme": "◐"
    },
    "note": "Geometric unicode glyph set shared by web and mobile for navigation and system concepts — always accompanied by a text label. Status is always a colored dot, never a glyph."
  },
  "layout": {
    "web": {
      "headerHeight": 64,
      "contentMax": 1200
