      "border": "rgba(226,240,232,0.10)",
      "strokeGradient": "linear-gradient(180deg, rgba(226,240,232,0.38) 0%, rgba(226,240,232,0.10) 46%, rgba(226,240,232,0.03) 100%)",
      "strokeWidthPx": 1.4,
      "blurSubtle": 14,
